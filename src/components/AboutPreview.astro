---
import { site, tools } from '../data/portfolioData';
import { assetPath, withBase } from '../lib/paths';
---
<section class="about-preview section-shell reveal">
  <div class="about-copy">
    <p class="eyebrow">ABOUT / EXPERIENCE</p>
    <h2>Profile.</h2>
    <p>
      I create Promotional videos, Event visuals, and Graphic designs.
    </p>
    <a class="text-link about-experience-link" href={withBase('/about/')}>
    View Experience <span>↗</span>
    </a>
  </div>

  <div class="about-image">
    <img src={assetPath(site.profileImage)} alt="斗湖 CROWNSHREDDER profile graphic" width="1280" height="1280" loading="lazy" />
  </div>

  <dl class="about-facts">
    <div><dt>Name</dt><dd>{site.personName}</dd></div>
    <div><dt>Role</dt><dd>{site.role}</dd></div>
    <div><dt>Specialty</dt><dd>BGA / PV / Motion / Design</dd></div>
    <div><dt>Tools</dt><dd>{tools.join(', ')}</dd></div>
  </dl>
</section>
