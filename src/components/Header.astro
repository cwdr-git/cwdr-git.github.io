---
import { site } from '../data/portfolioData';
import { withBase } from '../lib/paths';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const resolved = withBase(href);
  if (href === '/') return currentPath === resolved || currentPath === `${resolved}/`;
  return currentPath.startsWith(resolved.replace(/\/$/, ''));
};
---
<header class="site-header" data-header>
  <div class="header-inner shell">
    <a class="brand" href={withBase('/')} aria-label="CROWNSHREDDER home">
      <span class="brand-mark">{site.brandMark}</span>
      <span class="brand-divider">/</span>
      <span class="brand-name">{site.brandName}</span>
    </a>

    <button
      class="header-menu-trigger"
      type="button"
      aria-expanded="false"
      aria-controls="site-drawer"
      data-menu-open
    >
      <span class="header-menu-trigger__label">MENU</span>
      <span class="header-menu-trigger__icon" aria-hidden="true">
        <i></i>
        <i></i>
      </span>
    </button>
  </div>
</header>

<div class="site-drawer-backdrop" data-menu-close aria-hidden="true"></div>

<aside class="site-drawer" id="site-drawer" aria-hidden="true" aria-label="Site menu">
  <div class="site-drawer__top">
    <span>DIRECTORY</span>
    <button class="site-drawer__close" type="button" data-menu-close>
      CLOSE <span aria-hidden="true">×</span>
    </button>
  </div>

  <nav class="site-drawer__nav" aria-label="Primary navigation">
    {site.nav.map((item, index) => (
      <a class:list={{ active: isActive(item.href) }} href={withBase(item.href)} data-drawer-link>
        <span>{String(index + 1).padStart(2, '0')}</span>
        <strong>{item.label}</strong>
      </a>
    ))}
  </nav>

  <div class="site-drawer__bottom">
    <span>{site.role}</span>
    <span>CWDR / 2026</span>
  </div>
</aside>

<script>
  const openButton = document.querySelector('[data-menu-open]');
  const drawer = document.querySelector('.site-drawer');
  const backdrop = document.querySelector('.site-drawer-backdrop');
  const closeTargets = document.querySelectorAll('[data-menu-close]');
  const drawerLinks = document.querySelectorAll('[data-drawer-link]');

  const openMenu = () => {
    document.body.classList.add('drawer-open');
    openButton?.setAttribute('aria-expanded', 'true');
    drawer?.setAttribute('aria-hidden', 'false');
  };

  const closeMenu = () => {
    document.body.classList.remove('drawer-open');
    openButton?.setAttribute('aria-expanded', 'false');
    drawer?.setAttribute('aria-hidden', 'true');
  };

  openButton?.addEventListener('click', openMenu);
  closeTargets.forEach((target) => target.addEventListener('click', closeMenu));
  drawerLinks.forEach((link) => link.addEventListener('click', closeMenu));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && document.body.classList.contains('drawer-open')) {
      closeMenu();
    }
  });

  backdrop?.addEventListener('click', closeMenu);
</script>
