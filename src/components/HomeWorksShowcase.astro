---
import type { Project } from '../data/portfolioData';
import { assetPath, withBase } from '../lib/paths';

interface Props {
  projects: Project[];
  title?: string;
  eyebrow?: string;
  linkLabel?: string;
  linkHref?: string;
  sectionId?: string;
}

const {
  projects,
  title = 'Works.',
  eyebrow = 'SELECTED WORKS / 002',
  linkLabel = 'View all works',
  linkHref = '/works/',
  sectionId = 'home-works-title'
} = Astro.props;
---

<section
  class="home-works-showcase section-shell reveal"
  aria-labelledby={sectionId}
>
  <div class="home-works-showcase__head">
    <h2 id={sectionId}>{title}</h2>

    <div class="home-works-showcase__links">
      <p class="eyebrow home-works-showcase__eyebrow">
        {eyebrow}
      </p>

      <a class="text-link" href={withBase(linkHref)}>
        {linkLabel} <span>↗</span>
      </a>
    </div>
  </div>

  <div class="home-works-stack">
    {projects.map((project, index) => (
      <a
        class="home-work-strip"
        href={withBase(`/works/${project.slug}/`)}
        aria-label={`${project.title} 프로젝트 보기`}
      >
        <img
          src={assetPath(project.thumbnail)}
          alt=""
          width="1600"
          height="900"
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />

        <span class="home-work-strip__info" aria-hidden="true">
          <span class="home-work-strip__meta">
            <span>{project.category}</span>
            {project.year && <span>{project.year}</span>}
          </span>
          <strong>{project.title}</strong>
        </span>

        <span class="home-work-strip__arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>
