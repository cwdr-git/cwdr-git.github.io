---
interface Props {
  eyebrow: string;
  title?: string;
  linkLabel?: string;
  linkHref?: string;
}
import { withBase } from '../lib/paths';
const { eyebrow, title, linkLabel, linkHref } = Astro.props;
---
<div class="section-heading reveal">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    {title && <h2>{title}</h2>}
  </div>
  {linkLabel && linkHref && <a class="text-link" href={withBase(linkHref)}>{linkLabel} <span>↗</span></a>}
</div>
