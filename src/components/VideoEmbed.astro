---
interface Props {
  url?: string;
  title: string;
  fallbackImage: string;
}

import { assetPath } from '../lib/paths';

const { url, title, fallbackImage } = Astro.props;

function getVideoEmbedUrl(input?: string) {
  if (!input) return null;

  try {
    const parsed = new URL(input);
    const hostname = parsed.hostname
      .replace(/^www\./, '')
      .toLowerCase();

    const pathParts = parsed.pathname
      .split('/')
      .filter(Boolean);

    /* YouTube 단축 주소
       https://youtu.be/VIDEO_ID
    */
    if (hostname === 'youtu.be') {
      const videoId = pathParts[0];

      return videoId
        ? `https://www.youtube-nocookie.com/embed/${videoId}`
        : null;
    }

    /* YouTube 일반, Shorts, Embed 주소 */
    if (
      hostname === 'youtube.com' ||
      hostname === 'm.youtube.com' ||
      hostname === 'youtube-nocookie.com'
    ) {
      let videoId: string | null = null;

      /* https://youtube.com/watch?v=VIDEO_ID */
      if (parsed.pathname === '/watch') {
        videoId = parsed.searchParams.get('v');
      }

      /* https://youtube.com/shorts/VIDEO_ID */
      if (pathParts[0] === 'shorts') {
        videoId = pathParts[1] ?? null;
      }

      /* https://youtube.com/embed/VIDEO_ID */
      if (pathParts[0] === 'embed') {
        videoId = pathParts[1] ?? null;
      }

      return videoId
        ? `https://www.youtube-nocookie.com/embed/${videoId}`
        : null;
    }

    /* Vimeo 플레이어 주소
       https://player.vimeo.com/video/VIDEO_ID
    */
    if (
      hostname === 'player.vimeo.com' &&
      pathParts[0] === 'video'
    ) {
      const videoId = pathParts[1];

      if (!videoId) return null;

      const embedUrl =
        new URL(`https://player.vimeo.com/video/${videoId}`);

      /* 비공개 링크용 h 파라미터 유지 */
      const hash = parsed.searchParams.get('h');

      if (hash) {
        embedUrl.searchParams.set('h', hash);
      }

      return embedUrl.toString();
    }

    /* Vimeo 일반 공유 주소
       https://vimeo.com/VIDEO_ID
       https://vimeo.com/VIDEO_ID/HASH
       https://vimeo.com/channels/CHANNEL/VIDEO_ID
    */
    if (hostname === 'vimeo.com') {
      const videoId = pathParts.find((part) =>
        /^\d+$/.test(part)
      );

      if (!videoId) return null;

      const embedUrl =
        new URL(`https://player.vimeo.com/video/${videoId}`);

      const videoIndex = pathParts.indexOf(videoId);
      const privateHash = pathParts[videoIndex + 1];

      /* 비공개 Vimeo 링크의 해시값 보존 */
      if (
        privateHash &&
        !/^\d+$/.test(privateHash)
      ) {
        embedUrl.searchParams.set('h', privateHash);
      }

      return embedUrl.toString();
    }

    return null;
  } catch {
    return null;
  }
}

const embedUrl = getVideoEmbedUrl(url);
---

<div class="video-frame">
  {
    embedUrl ? (
      <iframe
        src={embedUrl}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    ) : (
      <img
        src={assetPath(fallbackImage)}
        alt={`${title} project visual`}
        width="1600"
        height="900"
        loading="lazy"
      />
    )
  }
</div>
