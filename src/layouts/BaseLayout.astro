---
import Header from '../components/Header.astro';
import ContactFooter from '../components/ContactFooter.astro';
import '../styles/global.css';
import { assetPath, withBase } from '../lib/paths';
import { site } from '../data/portfolioData';

interface Props {
  title?: string;
  description?: string;
  showFooter?: boolean;
}
const {
  title = `${site.brand} — Motion Designer`,
  description = site.intro,
  showFooter = true
} = Astro.props;
const normalizePath = (path: string) =>
  path.replace(/\/+$/, '') || '/';

const isHomePage =
  normalizePath(Astro.url.pathname) === normalizePath(withBase('/'));
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080a0b" />
    <link rel="icon" type="image/png" href={assetPath('/images/favicon.png')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={assetPath('/images/og-image.jpg')} />
    <title>{title}</title>
  </head>
  <body class:list={{ 'page-home': isHomePage }}>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    {showFooter && <ContactFooter />}
<script is:inline>
  const isHome = document.body.classList.contains('page-home');
  const revealElements = document.querySelectorAll('.reveal');

  if (isHome) {
    // Home에서는 기존 스크롤 등장 효과 유지
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (!reduceMotion && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );

      revealElements.forEach((element) => {
        observer.observe(element);
      });
    } else {
      revealElements.forEach((element) => {
        element.classList.add('is-visible');
      });
    }
  } else {
    // Home 이외의 페이지에서는 모든 요소 즉시 표시
    revealElements.forEach((element) => {
      element.classList.add('is-visible');
    });
  }
    </script>
  </body>
</html>
