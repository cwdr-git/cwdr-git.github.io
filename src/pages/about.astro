---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceList from '../components/ExperienceList.astro';
import { capabilities, site, tools } from '../data/portfolioData';
import { assetPath } from '../lib/paths';
---
<BaseLayout title="About / Experience — 斗湖">
  <section class="page-intro section-shell reveal">
    <p class="eyebrow">ABOUT / EXPERIENCE</p>
    <h1>Crafting Motion, <br />Shaping Visual Identity.</h1>
  </section>

  <section class="about-page section-shell">
    <div class="about-page__image reveal">
      <img src={assetPath(site.profileImage)} alt="斗湖 CROWNSHREDDER profile graphic" width="1280" height="1280" />
    </div>
    <div class="about-page__bio reveal">
      <p class="eyebrow">PROFILE</p>
      <h2>{site.brandMark}</h2>
        <dl class="about-facts">
          <div><dt>Name</dt><dd>{site.personName}</dd></div>
          <div><dt>Born</dt><dd>1998 . 12 . 05</dd></div>
          <div><dt>Desired Position</dt><dd>Designer / Editor / Event Planner</dd></div>
        </dl>
      <p>1998년생으로 중학생 때부터 영상 제작을 시작했습니다.</p>
      <p>2021년부터 약 1년 8개월 동안 회사에서 근무하며 협업과 기획 능력을 익혔고, 이후 개인 활동을 통해 다양한 영상 · 그래픽 프로젝트에 도전하고 있습니다.</p>
    </div>
  </section>

  <section class="skills section-shell reveal">
    <div><p class="eyebrow">CAPABILITIES</p><ul>{capabilities.map((item) => <li>{item}</li>)}</ul></div>
    <div><p class="eyebrow">TOOLS</p><ul>{tools.map((item) => <li>{item}</li>)}</ul></div>
  </section>

  <section class="experience section-shell">
    <p class="eyebrow">TIMELINE</p>
    <ExperienceList />
  </section>
</BaseLayout>
